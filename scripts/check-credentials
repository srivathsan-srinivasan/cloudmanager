#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/check-credentials [--all|--gcp|--aws|--azure|--doctl] [--smoke]

Checks whether local provider credentials are usable before opening CloudManager.

Modes:
  --all      Check all supported providers. Default.
  --gcp      Check gcloud CLI auth and ADC auth.
  --aws      Check AWS caller identity.
  --azure    Check Azure account.
  --doctl    Check DigitalOcean account.
  --smoke    Also run CloudManager's non-destructive smoke test.

Examples:
  scripts/check-credentials --gcp
  scripts/check-credentials --gcp --smoke
  scripts/check-credentials --all
USAGE
}

want_gcp=0
want_aws=0
want_azure=0
want_doctl=0
run_smoke=0

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
    --all)
      want_gcp=1
      want_aws=1
      want_azure=1
      want_doctl=1
      ;;
    --gcp)
      want_gcp=1
      ;;
    --aws)
      want_aws=1
      ;;
    --azure)
      want_azure=1
      ;;
    --doctl|--digitalocean)
      want_doctl=1
      ;;
    --smoke)
      run_smoke=1
      ;;
    *)
      echo "check-credentials: unknown argument: $arg" >&2
      usage
      exit 2
      ;;
  esac
done

if [[ $# -eq 0 || "$want_gcp$want_aws$want_azure$want_doctl" == "0000" ]]; then
  want_gcp=1
  want_aws=1
  want_azure=1
  want_doctl=1
fi

ok_count=0
fail_count=0

ok() {
  ok_count=$((ok_count + 1))
  printf '✓ %s\n' "$*"
}

fail() {
  fail_count=$((fail_count + 1))
  printf '✗ %s\n' "$*"
}

skip() {
  printf '- %s\n' "$*"
}

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

check_gcp() {
  printf '\nGCP\n'
  if ! has_cmd gcloud; then
    fail "gcloud missing"
    return
  fi
  ok "gcloud installed: $(gcloud version 2>/dev/null | awk '/Google Cloud SDK/ {print $4; exit}')"

  local active_account
  active_account="$(gcloud config get-value account 2>/dev/null || true)"
  if [[ -n "$active_account" && "$active_account" != "(unset)" ]]; then
    ok "active gcloud account: $active_account"
  else
    fail "no active gcloud account; run: gcloud auth login --no-browser"
  fi

  local active_project
  active_project="$(gcloud config get-value project 2>/dev/null || true)"
  if [[ -n "$active_project" && "$active_project" != "(unset)" ]]; then
    ok "active gcloud project: $active_project"
  else
    skip "no active gcloud project"
  fi

  if gcloud auth print-access-token >/dev/null 2>&1; then
    ok "gcloud CLI access token works"
  else
    fail "gcloud CLI token failed; run: gcloud auth login --no-browser"
  fi

  if gcloud auth application-default print-access-token >/dev/null 2>&1; then
    ok "ADC access token works"
  else
    fail "ADC token failed; run: gcloud auth application-default login"
  fi

  if [[ -n "$active_project" && "$active_project" != "(unset)" ]]; then
    if gcloud projects describe "$active_project" --format='value(projectId)' >/dev/null 2>&1; then
      ok "can describe active project: $active_project"
    else
      fail "cannot describe active project: $active_project"
    fi
  fi
}

check_aws() {
  printf '\nAWS\n'
  if ! has_cmd aws; then
    fail "aws missing"
    return
  fi
  ok "aws installed: $(aws --version 2>&1 | awk '{print $1}')"
  if aws sts get-caller-identity >/dev/null 2>&1; then
    ok "AWS caller identity works"
  else
    fail "AWS caller identity failed; run: aws configure or aws sso login"
  fi
}

check_azure() {
  printf '\nAzure\n'
  if ! has_cmd az; then
    fail "az missing"
    return
  fi
  ok "az installed"
  if az account show >/dev/null 2>&1; then
    local account
    account="$(az account show --query 'user.name' -o tsv 2>/dev/null || true)"
    ok "Azure account works${account:+: $account}"
  else
    fail "Azure account failed; run: az login --use-device-code"
  fi
}

check_doctl() {
  printf '\nDigitalOcean\n'
  if ! has_cmd doctl; then
    fail "doctl missing"
    return
  fi
  ok "doctl installed"
  if doctl account get >/dev/null 2>&1; then
    ok "DigitalOcean account works"
  else
    fail "DigitalOcean account failed; run: doctl auth init"
  fi
}

[[ "$want_gcp" -eq 1 ]] && check_gcp
[[ "$want_aws" -eq 1 ]] && check_aws
[[ "$want_azure" -eq 1 ]] && check_azure
[[ "$want_doctl" -eq 1 ]] && check_doctl

if [[ "$run_smoke" -eq 1 ]]; then
  printf '\nCloudManager smoke\n'
  target="all"
  if [[ "$want_gcp$want_aws$want_azure$want_doctl" != "1111" ]]; then
    if [[ "$want_gcp" -eq 1 ]]; then target="gcp"; fi
    if [[ "$want_aws" -eq 1 ]]; then target="aws"; fi
    if [[ "$want_azure" -eq 1 ]]; then target="azure"; fi
    if [[ "$want_doctl" -eq 1 ]]; then target="digitalocean"; fi
  fi
  if go run . --smoke-test="$target"; then
    ok "CloudManager smoke test passed: $target"
  else
    fail "CloudManager smoke test failed: $target"
  fi
fi

printf '\nSummary: ok=%d failed=%d\n' "$ok_count" "$fail_count"
if [[ "$fail_count" -gt 0 ]]; then
  exit 1
fi
