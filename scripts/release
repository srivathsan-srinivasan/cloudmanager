#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/release <version> [--push] [--no-push] [--skip-tests]

Examples:
  scripts/release v1.0.2
  scripts/release 1.0.2 --push

This script:
  - requires a clean worktree
  - runs from a dev/* branch
  - runs go test ./...
  - updates VERSION, README install pins, and scripts/install default
  - commits the release bump
  - optionally pushes the current branch for a pull request

After the release prep PR is merged, run the Release Go Module workflow from the
protected release/v1 branch. It validates the pins and creates the tag.
USAGE
}

if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

raw_version=""
push_release=0
run_tests=1

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
    --no-push)
      push_release=0
      ;;
    --push)
      push_release=1
      ;;
    --skip-tests)
      run_tests=0
      ;;
    v*|[0-9]*)
      if [[ -n "$raw_version" ]]; then
        echo "release: version provided more than once" >&2
        exit 2
      fi
      raw_version="$arg"
      ;;
    *)
      echo "release: unknown argument: $arg" >&2
      usage
      exit 2
      ;;
  esac
done

if [[ -z "$raw_version" ]]; then
  echo "release: missing version" >&2
  usage
  exit 2
fi

version="${raw_version#v}"
tag="v${version}"

if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "release: version must be stable semver like v1.0.0" >&2
  exit 2
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "release: worktree must be clean before preparing ${tag}" >&2
  git status --short
  exit 1
fi

branch="$(git branch --show-current)"
if [[ -z "$branch" ]]; then
	echo "release: cannot prepare release from detached HEAD" >&2
	exit 1
fi
if [[ ! "$branch" =~ ^dev/ ]]; then
	echo "release: prepare releases from a dev/* branch, not ${branch}" >&2
	echo "release: example: git switch -c dev/release-${tag}" >&2
	exit 1
fi

if [[ "$run_tests" -eq 1 ]]; then
  GOCACHE="${GOCACHE:-/tmp/go-build-cache}" go test ./...
fi

printf '%s\n' "$version" > VERSION

VERSION="$version" perl -0pi -e 's#raw\.githubusercontent\.com/vyoogam/cloudmanager/v[0-9]+\.[0-9]+\.[0-9]+/scripts/install#raw.githubusercontent.com/vyoogam/cloudmanager/v$ENV{VERSION}/scripts/install#g; s#go install github\.com/vyoogam/cloudmanager\@v[0-9]+\.[0-9]+\.[0-9]+#go install github.com/vyoogam/cloudmanager@v$ENV{VERSION}#g' README.md
VERSION="$version" perl -0pi -e 's#CLOUDMANAGER_VERSION:-v[0-9]+\.[0-9]+\.[0-9]+#CLOUDMANAGER_VERSION:-v$ENV{VERSION}#g; s#--version v[0-9]+\.[0-9]+\.[0-9]+#--version v$ENV{VERSION}#g; s#Default: v[0-9]+\.[0-9]+\.[0-9]+#Default: v$ENV{VERSION}#g' scripts/install

git diff --check
git add VERSION README.md scripts/install
if git diff --cached --quiet; then
  echo "release: ${tag} pins are already prepared"
else
  git commit -m "release: ${tag}"
fi

if [[ "$push_release" -eq 1 ]]; then
  git push origin "$branch"
else
	echo "release: prepared ${tag}; push the PR branch with:"
	echo "  git push origin ${branch}"
	echo "then open a PR into release/v1"
fi
