#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/release <version> [--no-push] [--skip-tests]

Examples:
  scripts/release v1.0.0
  scripts/release 1.0.0 --no-push

This script:
  - requires a clean worktree
  - runs go test ./...
  - updates VERSION, README install pins, scripts/install default, and Formula/cloudmanager.rb
  - commits the release bump
  - creates an annotated tag
  - pushes the current branch and tag unless --no-push is passed
USAGE
}

if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

raw_version=""
push_release=1
run_tests=1

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
    --no-push)
      push_release=0
      ;;
    --skip-tests)
      run_tests=0
      ;;
    v*|[0-9]*)
      if [[ -n "$raw_version" ]]; then
        echo "release: version provided more than once" >&2
        exit 2
      fi
      raw_version="$arg"
      ;;
    *)
      echo "release: unknown argument: $arg" >&2
      usage
      exit 2
      ;;
  esac
done

if [[ -z "$raw_version" ]]; then
  echo "release: missing version" >&2
  usage
  exit 2
fi

version="${raw_version#v}"
tag="v${version}"

if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "release: version must be stable semver like v1.0.0" >&2
  exit 2
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "release: worktree must be clean before cutting ${tag}" >&2
  git status --short
  exit 1
fi

if git rev-parse -q --verify "refs/tags/${tag}" >/dev/null; then
  echo "release: local tag ${tag} already exists" >&2
  exit 1
fi

branch="$(git branch --show-current)"
if [[ -z "$branch" ]]; then
  echo "release: cannot release from detached HEAD" >&2
  exit 1
fi

if [[ "$run_tests" -eq 1 ]]; then
  GOCACHE="${GOCACHE:-/tmp/go-build-cache}" go test ./...
fi

printf '%s\n' "$version" > VERSION

VERSION="$version" perl -0pi -e 's#raw\.githubusercontent\.com/vyoogam/cloudmanager/v[0-9]+\.[0-9]+\.[0-9]+/scripts/install#raw.githubusercontent.com/vyoogam/cloudmanager/v$ENV{VERSION}/scripts/install#g; s#go install github\.com/vyoogam/cloudmanager\@v[0-9]+\.[0-9]+\.[0-9]+#go install github.com/vyoogam/cloudmanager@v$ENV{VERSION}#g' README.md
VERSION="$version" perl -0pi -e 's#CLOUDMANAGER_VERSION:-v[0-9]+\.[0-9]+\.[0-9]+#CLOUDMANAGER_VERSION:-v$ENV{VERSION}#g; s#--version v[0-9]+\.[0-9]+\.[0-9]+#--version v$ENV{VERSION}#g; s#Default: v[0-9]+\.[0-9]+\.[0-9]+#Default: v$ENV{VERSION}#g' scripts/install
VERSION="$version" perl -0pi -e 's/tag:\s*"v[0-9]+\.[0-9]+\.[0-9]+"/tag: "v$ENV{VERSION}"/g; s/version\s+"[0-9]+\.[0-9]+\.[0-9]+"/version "$ENV{VERSION}"/g' Formula/cloudmanager.rb

git diff --check
git add VERSION README.md scripts/install Formula/cloudmanager.rb
git commit -m "release: ${tag}"
git tag -a "$tag" -m "$tag"

if [[ "$push_release" -eq 1 ]]; then
  git push origin "$branch"
  git push origin "$tag"
else
  echo "release: created ${tag} locally; push with:"
  echo "  git push origin ${branch}"
  echo "  git push origin ${tag}"
fi
